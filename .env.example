DATABASE_URL="postgresql://radar:radar_dev@localhost:5435/radar?schema=public"
BETTER_AUTH_SECRET=cambiar-por-64-hex
BETTER_AUTH_URL=http://localhost:3000
MP_API_TICKET=cambiar
MP_MIN_INTERVAL_MS=3500
# Resend: envio de correo. El dominio radar.aeroconce.cl esta verificado (region sa-east-1).
RESEND_API_KEY=cambiar
RESEND_FROM="Radar de Licitaciones <notificaciones@radar.aeroconce.cl>"
# Destinatarios por defecto, separados por coma. Se pueden ajustar desde Configuracion.
NOTIFY_TO=cambiar@aeroconce.cl
# A donde llegan las respuestas: radar.aeroconce.cl no recibe correo (T-09).
RESEND_REPLY_TO=cambiar@aeroconce.cl
STORAGE_DIR=./storage
SESSION_IDLE_MINUTES=60
SEED_ADMIN_EMAIL=admin@aeroconce.cl
SEED_ADMIN_PASSWORD=cambiar
